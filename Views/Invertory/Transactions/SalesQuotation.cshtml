                                                <td><p id=""></p></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!--Item table End-->
                        <!--Entries form starts-->
                        <div class="col-md-12">
                            <h6 class="py-2 px-3 rounded-top mb-0 border-bottom mb-5 text-customtitle-primary" style="font-weight: 600;">
                                PAYMENT DETAILS
                            </h6>
                            <div class="card rounded-custom">
                                <div class="card-body basic-form">
                                    <form class="theme-form row g-3">
                                        <div class="col-md-8">
                                            <div class="row">
                                                <div class="row">
                                                    <div class="col-md-2 pr-0 d-flex align-items-center">
                                                        <span class="grpspn">Terms</span>
                                                    </div>
                                                    <div class="col-md-10 pl-0">
                                                        <input type="text" id="Terms" class="form-control Terms" data-ismandatory="false">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                <div class="row">
                                                    <div class="col-md-4 pr-0 d-flex align-items-center">
                                                        <span class="grpspn">Tax </span>
                                                    </div>
                                                    <div class="col-md-8 pl-0">
                                                        <input class="form-control " id="Tax" type="text" name="Tax" data-ismandatory="true" disabled>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                <div class="row">
                                                    <div class="col-md-4 pr-0 d-flex align-items-center">
                                                        <span class="grpspn">Total Discount </span>
                                                    </div>
                                                    <div class="col-md-8 pl-0">
                                                        <input class="form-control " id="TotalDiscount" type="text" name="TotalDiscount" data-ismandatory="true" disabled>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                <div class="row">
                                                    <div class="col-md-4 pr-0 d-flex align-items-center">
                                                        <span class="grpspn">Net Amount </span>
                                                    </div>
                                                    <div class="col-md-8 pl-0">
                                                        <input class="form-control " id="NetAmount" type="text" name="NetAmount" data-ismandatory="true" disabled>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                <div class="row">
                                                    <div class="col-md-4 pr-0 d-flex align-items-center">
                                                        <span class="grpspn">Add. Charges </span>
                                                    </div>
                                                    <div class="col-md-8 pl-0">
                                                        <input class="form-control " id="AdditionalCharges" type="text" name="AdditionalCharges" data-ismandatory="true">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                <div class="row">
                                                    <div class="col-md-4 pr-0 d-flex align-items-center">

                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td><p id=""></p></td>
                                                <td><p id=""></p></td>
                                                <td><p id=""></p></td>
                                                <td><p id=""></p></td>
                                                <td><p id="qtySum"></p></td>
                                                <td><p id=""></p></td>
                                                <td><p id="ItemGrossAmtSum"></p></td>
                                                <td><p id=""></p></td>
                                                <td><p id="dicsAmtSum"></p></td>
                                                <td><p id="amtSum"></p></td>

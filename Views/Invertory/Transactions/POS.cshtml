                                            <td><p id="dicsAmtSum" style="text-align:right"></p></td>
                                            <td><p id="amtSum" style="text-align:right"></p></td>
                                            <td><p id=""></p></td>
                                            <td><p id="taxAmtSum" style="text-align:right"></p></td>
                                            <td><p id="itemTotalSum" style="text-align:right"></p></td>
                                            <td><p id=""></p></td>
                                            <td><p id=""></p></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

                                <input type="text" class="text-center transparent_text" id="RowType" style="display:none" value="@ViewBag.RowType" />
                                <input type="text" class="text-center transparent_text" id="VoucherID" style="display:none" value="@ViewBag.VoucherID" />

                                <div class="col-md-4" id="vouchernodiv">
                                    <div class="row">
                                        <div class="row">
                                            <div class="col-md-4 pr-0 d-flex align-items-center">
                                                <span class="grpspn">Invoice No.<span class="text-danger">*</span></span>
                                            </div>
                                            <div class="col-md-8 pl-0">
                                                <input type="text" id="VoucherNo" class="form-control " name="VoucherNo" data-ismandatory="true" disabled value="@ViewBag.VoucherNo">
                                            </div>
                                        </div>
                                        <span id="VoucherType" data-value="@ViewBag.voucher["ID"]"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="row">
                                        <div class="row">
                                            <div class="col-md-4 pr-0 d-flex align-items-center">
                                                <span class="grpspn">Invoice Date<span class="text-danger">*</span></span>
                                            </div>
                                            <div class="col-md-8 pl-0">
                                                <input type="date" id="VoucherDate" class="form-control " name="VoucherDate" data-ismandatory="true"  value="@ViewBag.TodayDate">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                @* <div class="col-md-4">
                                    <div class="row">
                                        @(await Component.InvokeAsync("TextBox", new { Type = "Date", ID = "VoucherDate", DisplayText = "Invoice Date", IsMandatory = true, Value = ViewBag.TodayDate }))
                                    </div>
                                </div> *@
                                <div class="col-md-4">
                                    <div class="row">
                                        @(await Component.InvokeAsync("TextBox",
                                            new
                                            {
                                                Type = "Lookup",
                                                ID = "Party",
                                                DisplayText = "Party",
                                                IDColumn = "ID",
                                                LookupCriteria = "Accounts",
                                                IDValue = 1,
                                                AssignColumn = "AccountName",
                                                IsMandatory = true
                                            })
                                        )
                                    </div>
                                </div>
                                <div class="col-md-4 d-flex gap-4">
                                    <a href="#" class="custom-link">Return</a>
                                    <a href="#" class="custom-link">Queue</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Individual column searching (text inputs) Starts-->
        <div class="col-xxl-9 box-col-12">
            <div class="card">
               
                <div class="card-body">
                    <div class="row">
                        <h6 class="py-2 px-3 rounded-top mb-0 border-bottom mb-5 text-custom-primary" style="font-weight: 600;">
                            ITEMS
                        </h6>
                        <div class="card rounded-custom overflow-hidden">

                            <div class="table-responsive">
                                <table class="table table-light" id="Itemtable">
                                    <thead>
                                        <tr class="text-center">
                                            <th style="width:4%">#</th>
                                            <th style="width:6%"></th>
                                            <th style="width:22%">Item Name</th>
                                            <th style="width:8%">Unit</th>
                                            <th style="width:6%">Qty</th>
                                            <th style="width:8%">Rate</th>
                                            <th style="width:8%">Gross</th>
                                            <th style="width:6%">Disc%</th>
                                            <th style="width:8%">Disc</th>
                                            <th style="width:8%">Amount</th>

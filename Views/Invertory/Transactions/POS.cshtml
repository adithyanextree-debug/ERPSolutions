<style>
    #Itemtable {
        width: 100%;
        table-layout: fixed;
    }

        #Itemtable th,
        #Itemtable td {
            padding: 4px 6px;
            font-size: 13px;
            vertical-align: middle;
        }

        #Itemtable input,
        #Itemtable select {
            width: 100%;
            min-width: 0;
            height: 28px;
            font-size: 13px;
            padding: 2px 4px;
        }

        #Itemtable img {
            max-width: 40px;
            height: auto;
        }

        #Itemtable thead th {
            background-color: #f8f9fa;
            font-weight: 600;
            white-space: nowrap;
        }

        #Itemtable tfoot td {
            font-weight: 600;
            background: #fafafa;
        }

    .custom-link {
        color: #4da3ff; /* light blue */
        text-decoration: underline;
        font-weight: 500;
    }

        .custom-link:hover {
            color: #1e7be6; /* slightly darker on hover */
        }

    .disabledfield {
        background-color: #f2f2f2; /* Lighter background to indicate it's disabled */
        pointer-events: none; /* Disable clicking and interaction */
        opacity: 0.5; /* Reduce opacity to show it's not interactable */
    }
</style>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6 col-12">
                <h2>Sales POS</h2>
            </div>
            <div class="col-sm-6 col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="iconly-Home icli svg-color"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Inventory</li>
                    <li class="breadcrumb-item">Transaction</li>
                    <li class="breadcrumb-item">Sales</li>
                    <li class="breadcrumb-item active">Sales POS</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- Container-fluid starts-->
<div class="container-fluid credit-card">
    <div class="row">
        <div class="list-product-header mt-4">
            <div>
                <ul class="quick-file d-flex flex-row">
                     <li onclick="NewEntry()" id="NewLi" style="display:none">
                        <div class="quick-box">
                            <i class="fa-solid fa-plus text-warning"></i>
                        </div>
                        <h6 class="mb-2">New</h6>
                    </li>
                    <li onclick="SaveEntry()">
                        <div class="quick-box">
                            <i class="fa-solid fa-save text-info"></i>
                        </div>
                        <h6 class="mb-2">Save</h6>
                    </li>
                    <li onclick="CloseEntry()">
                        <div class="quick-box">
                            <i class="fa-solid fa-close text-danger"></i>
                        </div>
                        <h6 class="mb-2">Close</h6>
                    </li>
                    @*   <li onclick="DeleteEntry()" id="DeleteLi">
                        <div class="quick-box">
                            <i class="fa-solid fa-trash text-danger"></i>
                        </div>
                        <h6 class="mb-2">Delete</h6>
                    </li> *@
                </ul>
            </div>
        </div>
        <div class="col-xxl-12 box-col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 order-md-0 order-1">

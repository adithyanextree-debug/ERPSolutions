                                            </th>
                                            <th style="width:4%" class="ps-3">
                                                <i class="fa-solid fa-minus text-danger"></i>
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @await Html.PartialAsync("~/Views/Invertory/Transactions/_ItemRow.cshtml",
                                                                                (int)ViewBag.FirstRowSerial)


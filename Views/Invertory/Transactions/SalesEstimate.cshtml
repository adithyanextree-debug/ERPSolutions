@using System.Data@{
    ViewData["Title"] = "Sales Estimate";
}

<style>
    /* ─── Table Style ─────────────────────────────────────────── */
    #Itemtable {
        width: 100%;
        border-collapse: collapse;
    }

        #Itemtable thead tr {
            background-color: #f0f4ff;
            font-size: 13px;
            font-weight: 600;
            color: #333;
        }

        #Itemtable thead th {
            padding: 8px 6px;
            white-space: nowrap;
            border: 1px solid #c8d0e7;
            text-align: center;
        }

        /* ─── Striped tbody rows ──────────────────────────────────── */
        #Itemtable tbody tr:nth-child(odd) {
            background-color: #ffffff !important;
        }

        #Itemtable tbody tr:nth-child(even) {
            background-color: #f7f9ff !important;
        }

        #Itemtable tbody tr:hover {
            background-color: #eef2ff !important;
        }

        /* ─── TD borders ──────────────────────────────────────────── */
        #Itemtable tbody td {
            padding: 3px 4px !important;
            vertical-align: middle !important;
            border: 1px solid #c8d0e7 !important;
        }

        /* ─── NO border for inputs/selects inside td ─────────────── */
        #Itemtable input.form-control,
        #Itemtable select.form-select {
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            background-color: transparent !important;
            padding: 4px 6px !important;
            font-size: 13px !important;
            outline: none !important;
        }

            /* ─── Focus highlight on input/select ────────────────────── */
            #Itemtable input.form-control:focus,
            #Itemtable select.form-select:focus {
                background-color: #dde8ff !important;
                outline: none !important;
                box-shadow: none !important;
                border: none !important;
            }

            /* ─── Disabled inputs ─────────────────────────────────────── */
            #Itemtable input.form-control:disabled,
            #Itemtable select.form-select:disabled {
                background-color: transparent !important;
                color: #444 !important;
                cursor: default !important;
            }

        /* ─── Serial number ───────────────────────────────────────── */
        #Itemtable td.serial-no {
            text-align: center !important;
            font-weight: 600;
            color: #555;
            font-size: 12px;
        }
        /* ─── Image align to center ───────────────────────────────────────── */

        #Itemtable tbody td:nth-child(2) {
            text-align: center;
            vertical-align: middle;
        }

    .col-form-label {
        font-size: 13px;
        padding-top: 6px;
        font-weight: 500;
    }
</style>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6 col-12">
                <h2>Sales Estimate</h2>
            </div>
            <div class="col-sm-6 col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="iconly-Home icli svg-color"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Inventory</li>
                    <li class="breadcrumb-item">Transaction</li>
                    <li class="breadcrumb-item">Sales</li>
                    <li class="breadcrumb-item active">Sales Estimate</li>
                </ol>
            </div>
        </div>
    </div>
</div>


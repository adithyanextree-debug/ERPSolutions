@model ERPSample.Models.Inventory.Reports.InventoryProfitModel
@using System.Data
@{
    var dt = ViewBag.ReportData as DataTable;
}
@if (dt == null || dt.Rows.Count == 0)
{
    <div class="alert alert-warning">No records found for the selected filters.</div>
    return;
}
@{
    string Val(DataRow r, string col)
        => r[col] == DBNull.Value ? "" : r[col].ToString();

    string Num(DataRow r, string col)
        => r[col] == DBNull.Value ? "" : string.Format("{0:N3}", r[col]);

    string Dt(DataRow r, string col)
        => r[col] == DBNull.Value ? "" : Convert.ToDateTime(r[col]).ToString("dd-MM-yyyy");
    var ignoreColumns = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "ItemID",
        "ID",
        "AccountID",
    };
}
<div class="table-responsive" style="overflow-x: auto;">
    <table id="inventoryprofitTable" class="table table-bordered table-sm table-hover">
        @* ==================== THEAD ==================== *@
        <thead>
            @* ---------- ITEM ---------- *@
            @if (Model.Criteria == "Item")
            {
                <tr>
                    <th>#</th>
                    @foreach (DataColumn col in dt.Columns)
                    {
                        if (ignoreColumns.Contains(col.ColumnName))
                        {
                            continue;
                        }
                        <th>@col.ColumnName</th>
                    }
                </tr>
            }
            @* ---------- VOUCHER ---------- *@
            else if (Model.Criteria == "Voucher")
            {
                <tr>
                    <th>#</th>

                    @foreach (DataColumn col in dt.Columns)
                    {
                        if (ignoreColumns.Contains(col.ColumnName))
                        {
                            continue;
                        }

                        if (col.ColumnName == "SalesQty")
                        {
                            <th class="text-center" colspan="3">Sales</th>
                        }

                        if (col.ColumnName == "StockQty")
                        {
                            <th class="text-center" colspan="3">Stock</th>
                        }

                        if (col.ColumnName == "GrossProfit")
                        {
                            <th class="text-center" colspan="3">Gross Profit</th>
                        }

                        // Don't print the grouped columns in first row
                        if (col.ColumnName == "SalesQty" ||
                        col.ColumnName == "SalesRate" ||
                        col.ColumnName == "SalesAmount" ||
                        col.ColumnName == "StockQty" ||
                        col.ColumnName == "StockRate" ||
                        col.ColumnName == "StockAmount" ||
                        col.ColumnName == "GrossProfit" ||
                        col.ColumnName == "GP(%)" ||
                        col.ColumnName == "%OfTotalGP")
                        {
                            continue;
                        }
                        <th>@col.ColumnName</th>
                    }
                </tr>
                <tr>
                    <th></th>

                    @foreach (DataColumn col in dt.Columns)
                    {
                        if (ignoreColumns.Contains(col.ColumnName))
                        {
                            continue;
                        }

                        // Only print the grouped columns in second row
                        if (col.ColumnName == "SalesQty" ||
                        col.ColumnName == "SalesRate" ||
                        col.ColumnName == "SalesAmount" ||
                        col.ColumnName == "StockQty" ||
                        col.ColumnName == "StockRate" ||
                        col.ColumnName == "StockAmount" ||
                        col.ColumnName == "GrossProfit" ||
                        col.ColumnName == "GP(%)" ||
                        col.ColumnName == "%OfTotalGP")
                        {
                            <th>@col.ColumnName</th>
                        }
                        else
                        {
                            <th></th>
                        }
                    }
                </tr>
            }
            @* ---------- PARTY ---------- *@
            else if (Model.Criteria == "Party")
            {
                <tr>
                    <th>#</th>

                    @foreach (DataColumn col in dt.Columns)
                    {
                        if (ignoreColumns.Contains(col.ColumnName))
                        {
                            continue;
                        }

                        if (col.ColumnName == "SalesQty")
                        {
                            <th class="text-center" colspan="3">Sales</th>
                        }

                        if (col.ColumnName == "StockQty")
                        {
                            <th class="text-center" colspan="3">Stock</th>
                        }

                        if (col.ColumnName == "GrossProfit")
                        {
                            <th class="text-center" colspan="3">Gross Profit</th>
                        }

                        // Don't print the grouped columns in first row
                        if (col.ColumnName == "SalesQty" ||
                        col.ColumnName == "SalesRate" ||
                        col.ColumnName == "SalesAmount" ||
                        col.ColumnName == "StockQty" ||
                        col.ColumnName == "StockRate" ||
                        col.ColumnName == "StockAmount" ||
                        col.ColumnName == "GrossProfit" ||
                        col.ColumnName == "GP(%)" ||
                        col.ColumnName == "%OfTotalGP")
                        {
                            continue;
                        }
                        <th>@col.ColumnName</th>

                    }
                </tr>
                <tr>
                    <th></th>

                    @foreach (DataColumn col in dt.Columns)
                    {
                        if (ignoreColumns.Contains(col.ColumnName))
                        {
                            continue;
                        }

                        // Only print the grouped columns in second row
                        if (col.ColumnName == "SalesQty" ||
                        col.ColumnName == "SalesRate" ||
                        col.ColumnName == "SalesAmount" ||
                        col.ColumnName == "StockQty" ||
                        col.ColumnName == "StockRate" ||
                        col.ColumnName == "StockAmount" ||
                        col.ColumnName == "GrossProfit" ||
                        col.ColumnName == "GP(%)" ||
                        col.ColumnName == "%OfTotalGP")
                        {
                            <th>@col.ColumnName</th>
                        }
                        else
                        {
                            <th></th>
                        }
                    }
                </tr>
            }
        </thead>
        @* ==================== TBODY ==================== *@
        <tbody>
            @if (Model.Criteria == "Item")
            {
                int Sn = 0;
                @foreach (DataRow row in dt.Rows)
                {
                    Sn++;
                    <tr>
                        <td>@Sn</td>
                        @foreach (DataColumn col in dt.Columns)
                        {
                            if (ignoreColumns.Contains(col.ColumnName))
                            {
                                continue;
                            }

                            if (col.DataType == typeof(DateTime))
                            {
                                <td>@Dt(row, col.ColumnName)</td>
                            }
                            else if (col.DataType == typeof(decimal)
                            || col.DataType == typeof(double)
                            || col.DataType == typeof(float)
                            || col.DataType == typeof(int)
                            || col.DataType == typeof(long)
                            || col.DataType == typeof(short))
                            {
                                <td class="text-end">@Num(row, col.ColumnName)</td>
                            }
                            else
                            {
                                <td>@Val(row, col.ColumnName)</td>
                            }
                        }
                    </tr>
                }

            }
  
            @if (Model.Criteria == "Voucher")
            {
                int Sn = 0;
                @foreach (DataRow row in dt.Rows)
                {
                    Sn++;
                    <tr>
                        <td>@Sn</td>
                        @foreach (DataColumn col in dt.Columns)
                        {
                            if (ignoreColumns.Contains(col.ColumnName))
                            {
                                continue;
                            }

                            if (col.DataType == typeof(DateTime))
                            {
                                <td>@Dt(row, col.ColumnName)</td>
                            }
                            else if (col.DataType == typeof(decimal)
                            || col.DataType == typeof(double)
                            || col.DataType == typeof(float)
                            || col.DataType == typeof(int)
                            || col.DataType == typeof(long)
                            || col.DataType == typeof(short))
                            {
                                <td class="text-end">@Num(row, col.ColumnName)</td>
                            }
                            else
                            {
                                <td>@Val(row, col.ColumnName)</td>
                            }
                        }
                    </tr>
                }
            }
 
            @if (Model.Criteria == "Party")
            {
                int Sn = 0;
                @foreach (DataRow row in dt.Rows)
                {
                    Sn++;
                    <tr>
                        <td>@Sn</td>
                        @foreach (DataColumn col in dt.Columns)
                        {
                            if (ignoreColumns.Contains(col.ColumnName))
                            {
                                continue;
                            }

                            if (col.DataType == typeof(DateTime))
                            {
                                <td>@Dt(row, col.ColumnName)</td>
                            }
                            else if (col.DataType == typeof(decimal)
                            || col.DataType == typeof(double)
                            || col.DataType == typeof(float)
                            || col.DataType == typeof(int)
                            || col.DataType == typeof(long)
                            || col.DataType == typeof(short))
                            {
                                <td class="text-end">@Num(row, col.ColumnName)</td>
                            }
                            else
                            {
                                <td>@Val(row, col.ColumnName)</td>
                            }
                        }
                    </tr>
                }
            }
  
        </tbody>
    </table>
</div>

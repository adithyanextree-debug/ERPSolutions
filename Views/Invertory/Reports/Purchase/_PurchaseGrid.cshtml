@model ERPSample.Models.Inventory.Reports.Purchase.PurchaseRegisterModel
@using System.Data
@{
    var dt = ViewBag.ReportData as DataTable;
}

@if (dt == null || dt.Rows.Count == 0)
{
    <div class="alert alert-warning">No records found for the selected filters.</div>
    return;
}
@{
    string Val(DataRow r, string col)
        => r.Table.Columns.Contains(col) && r[col] != DBNull.Value ? r[col].ToString() : "";
    string Num(DataRow r, string col)
        => r.Table.Columns.Contains(col) && r[col] != DBNull.Value ? string.Format("{0:N3}", r[col]) : "";
    string Dt(DataRow r, string col)
        => r.Table.Columns.Contains(col) && r[col] != DBNull.Value ? Convert.ToDateTime(r[col]).ToString("dd-MM-yyyy") : "";

    // Only show inventory/columnar sections if the flag is on AND the columns actually exist
    bool showInventory = Model.IsInventory == true && dt.Columns.Contains("Qty");
    bool showColumnar = Model.IsColumnar == true && dt.Columns.Contains("DiscountReceived");
    var ignoreColumns = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "SlNo",
        "Type",
        "VID",
        "AccountID"
    };
}
<div class="table-responsive" style="overflow-x: auto;">
    <table id="purchaseTable" class="table table-bordered table-sm table-hover">
        <thead>
            <tr>
                @foreach (DataColumn col in dt.Columns)
                {
                    if (ignoreColumns.Contains(col.ColumnName))
                    {
                        continue;
                    }
                    <th>@col.ColumnName</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in dt.Rows)
            {
                var isMain = row.Table.Columns.Contains("Type")
                && row["Type"] != DBNull.Value
                && row["Type"].ToString() == "Main";
                string rowStyle = "";
                if (Model.IsInventory == true)
                {
                    rowStyle = "font-style:italic;";
                }
                else if (Model.IsDetailed == true && isMain)
                {
                    rowStyle = "font-weight:bold;color:#000;";
                }

                <tr style="@rowStyle">


                    @foreach (DataColumn col in dt.Columns)
                    {
                        if (ignoreColumns.Contains(col.ColumnName))
                        {
                            continue;
                        }

                        if (col.DataType == typeof(DateTime))
                        {
                            <td>@Dt(row, col.ColumnName)</td>
                        }
                        else if (col.DataType == typeof(decimal)
                        || col.DataType == typeof(double)
                        || col.DataType == typeof(float)
                        || col.DataType == typeof(int)
                        || col.DataType == typeof(long)
                        || col.DataType == typeof(short))
                        {
                            <td class="text-end">@Num(row, col.ColumnName)</td>
                        }
                        else
                        {
                            <td>@Val(row, col.ColumnName)</td>
                        }
                    }

                </tr>
            }
        </tbody>
           
            @*  <tfoot class="table-secondary fw-bold">
            <tr>
                <td colspan="4" class="text-end">Grand Total</td>
                <td class="text-end">@string.Format("{0:N3}", Model.TotalDebit)</td>
                <td class="text-end">@string.Format("{0:N3}", Model.TotalCredit)</td>
                <td colspan="6"></td>
            </tr>
        </tfoot> *@
        </table>
</div>


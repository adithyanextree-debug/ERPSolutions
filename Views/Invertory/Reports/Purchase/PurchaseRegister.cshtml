@model ERPSample.Models.Inventory.Reports.Purchase.PurchaseRegisterModel
@{
    ViewData["Title"] = "Purchase Register";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6 col-12">
                <h2>Purchase Register</h2>
            </div>
            <div class="col-sm-6 col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="iconly-Home icli svg-color"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Inventory</li>
                    <li class="breadcrumb-item">Reports</li>
                    <li class="breadcrumb-item">Purchase</li>
                    <li class="breadcrumb-item active">Purchase Register</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="list-product-header">
                        <div>
                            <ul class="quick-file d-flex flex-row">
                                <li onclick="printOnlyTable()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-print text-warning">
                                        </i>
                                    </div>
                                    <h6 class="mb-2">Print</h6>
                                </li>
                                <li onclick="exportToPDF()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-file text-info"></i>
                                    </div>
                                    <h6 class="mb-2">PDF</h6>
                                </li>
                                <li onclick="exportToExcel()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-book text-primary"></i>
                                    </div>
                                    <h6 class="mb-2">Excel</h6>
                                </li>
                                <li onclick="emailTableData()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-envelope text-title-gray"></i>
                                    </div>
                                    <h6 class="mb-2">Email</h6>
                                </li>
                                <li onclick="CloseEntry()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-close text-danger"></i>
                                    </div>
                                    <h6 class="mb-2">Close</h6>
                                </li>

                            </ul>
                        </div>
                    </div>
                    <div class="row g-2 align-items-center">

                        <!-- View By — label left, radios right -->
                       @*  <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">View by</span>
                                </div>
                                <div class="col-md-8 d-flex align-items-center gap-2">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="ViewBy"
                                               id="rbInventory" value="Inventory" checked />
                                        <label class="form-check-label" for="rbInventory">Inventory</label>
                                    </div>
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="radio" name="ViewBy"
                                               id="rbFinance" value="Finance" />
                                        <label class="form-check-label" for="rbFinance">Finance</label>
                                    </div>
                                </div>
                            </div>
                        </div> *@

                        <!-- From Date -->
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">From Date</span>
                                </div>
                                <div class="col-md-8" style="position:relative">
                                    <input type="date" id="FromDate" class="form-control"
                                           value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>

                        <!-- To Date -->
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">To Date</span>
                                </div>
                                <div class="col-md-8" style="position:relative">
                                    <input type="date" id="ToDate" class="form-control"
                                           value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>

                        <!-- Basic Type -->
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">Basic Type</span>
                                </div>
                                <div class="col-md-8" style="position:relative">
                                    <input type="text" id="BasicType" class="form-control"
                                           value="Purchase" readonly />
                                </div>
                            </div>
                        </div>

                        <!-- Hidden VoucherTypeID -->
                        <input type="hidden" id="VoucherTypeID" value="@ViewBag.voucher["ID"]" />

                        <!-- Party (Component - already has label left, input right) -->
                        <div class="col-md-3 mt-3">
                            @(await Component.InvokeAsync("TextBox",
                                                        new
                                                        {
                                                            Type = "Lookup",
                                                            ID = "Party",
                                                            DisplayText = "Party",
                                                            IDColumn = "AccountID",
                                                            LookupCriteria = "Suppliers",
                                                            IDValue = 0,
                                                            AssignColumn = "Name"
                                                        }))
                        </div>

                        <!-- Item (Component) -->
                        <div class="col-md-3 mt-3">
                            @(await Component.InvokeAsync("TextBox",
                                                        new
                                                        {
                                                            Type = "Lookup",
                                                            ID = "Item",
                                                            DisplayText = "Item",
                                                            IDColumn = "ID",
                                                            LookupCriteria = "Items",
                                                            IDValue = 0,
                                                            AssignColumn = "ItemName"
                                                        }))
                        </div>

                        <!-- Salesman (Component) -->
                        <div class="col-md-3 mt-3">
                            @(await Component.InvokeAsync("TextBox",
                                                        new
                                                        {
                                                            Type = "Lookup",
                                                            ID = "Salesman",
                                                            DisplayText = "Salesman",
                                                            IDColumn = "ID",
                                                            LookupCriteria = "Staff",
                                                            IDValue = 0,
                                                            AssignColumn = "AccountName",
                                                        })
                                                        )
                        </div>

                        <!-- Area (Component) -->
                        <div class="col-md-3 mt-3">
                            @(await Component.InvokeAsync("TextBox",
                                                        new
                                                        {
                                                            Type = "Lookup",
                                                            ID = "Area",
                                                            DisplayText = "Area",
                                                            IDColumn = "ID",
                                                            LookupCriteria = "Area",
                                                            IDValue = 0,
                                                            AssignColumn = "Name",
                                                        }))
                        </div>

                        <!-- Payment Type -->
                        <div class="col-md-3 mt-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">Payment Type</span>
                                </div>
                                <div class="col-md-8" style="position:relative">
                                    <select id="PaymentType" class="form-select">
                                        @Html.Raw(ViewBag.PaymentMode)
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Counter (Component) -->
                        <div class="col-md-3 mt-3">
                            @(await Component.InvokeAsync("TextBox",
                                                        new
                                                        {
                                                            Type = "Lookup",
                                                            ID = "Counter",
                                                            DisplayText = "Counter",
                                                            IDColumn = "ID",
                                                            LookupCriteria = "Counter",
                                                            IDValue = 0,
                                                            AssignColumn = "CounterName",
                                                        }))
                        </div>

                        <!-- Checkboxes + Buttons -->
                        <div class="col-md-4 mt-3">
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="IsColumnar" />
                                    <label class="form-check-label" for="IsColumnar">Columnar</label>
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="IsDetailed" />
                                    <label class="form-check-label" for="IsDetailed">Detailed?</label>
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="IsInventory" />
                                    <label class="form-check-label" for="IsInventory">Inventory</label>
                                </div>
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="IsGroupItem" />
                                    <label class="form-check-label" for="IsGroupItem">Group Item</label>
                                </div>
                                <div>
                                    <button id="btnGo" class="btn btn-primary btn-sm me-1">Go</button>
                                    <button id="btnClear" class="btn btn-secondary btn-sm">Clear</button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grid will be injected here by Ajax -->
<div class="container-fluid">
    <div id="gridContainer">
        <p class="text-muted text-center py-4">Select filters and click Go.</p>
    </div>
</div>

<script src="~/assets/custom/Inventory/Reports/Purchase/PurchaseRegister.js"></script>
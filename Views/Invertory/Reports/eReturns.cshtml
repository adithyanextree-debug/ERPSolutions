@model ERPSample.Models.Inventory.Reports.eReturnsModel
@{
    ViewData["Title"] = "eReturns";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6 col-12">
                <h2>eReturns</h2>
            </div>
            <div class="col-sm-6 col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="iconly-Home icli svg-color"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Inventory</li>
                    <li class="breadcrumb-item">Reports</li>
                    <li class="breadcrumb-item active">eReturns</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="list-product-header">
                        <div>
                            <ul class="quick-file d-flex flex-row">
                                <li onclick="printOnlyTable()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-print text-warning">
                                        </i>
                                    </div>
                                    <h6 class="mb-2">Print</h6>
                                </li>
                                <li onclick="exportToPDF()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-file text-info"></i>
                                    </div>
                                    <h6 class="mb-2">PDF</h6>
                                </li>
                                <li onclick="exportToExcel()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-book text-primary"></i>
                                    </div>
                                    <h6 class="mb-2">Excel</h6>
                                </li>
                                <li onclick="emailTableData()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-envelope text-title-gray"></i>
                                    </div>
                                    <h6 class="mb-2">Email</h6>
                                </li>
                                <li onclick="CloseEntry()">
                                    <div class="quick-box">
                                        <i class="fa-solid fa-close text-danger"></i>
                                    </div>
                                    <h6 class="mb-2">Close</h6>
                                </li>

                            </ul>
                        </div>
                    </div>
                    <div class="row g-2 align-items-center">
                         <!-- From Date -->
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">From Date</span>
                                </div>
                                <div class="col-md-8" style="position:relative">
                                    <input type="date" id="FromDate" class="form-control"
                                           value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>

                        <!-- To Date -->
                        <div class="col-md-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">To Date</span>
                                </div>
                                <div class="col-md-8" style="position:relative">
                                    <input type="date" id="ToDate" class="form-control"
                                           value="@Model.DateTo.ToString("yyyy-MM-dd")" />
                                </div>
                            </div>
                        </div>
                        <!-- Emirates -->
                        <div class="col-md-3 mt-3">
                            <div class="row">
                                <div class="col-md-4 d-flex align-items-center">
                                    <span class="grpspn">Emirate</span>
                                </div>
                                <div class="col-md-8" style="position:relative">
                                    <select id="Emirates" class="form-select">
                                        @Html.Raw(ViewBag.Emirates)
                                    </select>
                                </div>
                            </div>
                        </div>
                        <!-- Customer (Component - already has label left, input right) -->
                        <div class="col-md-3 mt-3">
                            @(await Component.InvokeAsync("TextBox",new{Type = "Lookup",ID = "Party",DisplayText = "Party",IDColumn = "AccountID",LookupCriteria = "Suppliers",
                            IDValue = 0,AssignColumn = "Name"}))
                        </div>
                          <div class="col-md-3 mt-3">
                                @(await Component.InvokeAsync("TextBox", new { Type = "Normal", ID = "TaxRegNo", DisplayText = "TaxRegNo" }))
                          </div>
                        <!-- Checkboxes + Buttons -->
                        <div class="col-md-4 mt-3">
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div>
                                    <button id="btnGo" class="btn btn-primary btn-sm me-1">Go</button>
                                    <button id="btnClear" class="btn btn-secondary btn-sm">Clear</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grid will be injected here by Ajax -->
<div class="container-fluid">
    <div id="gridContainer">
        <p class="text-muted text-center py-4">Select filters and click Go.</p>
    </div>
</div>

<script src="~/assets/custom/Inventory/Reports/eReturns.js"></script>

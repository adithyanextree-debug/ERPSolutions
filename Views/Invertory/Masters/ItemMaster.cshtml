@{
    ViewData["Title"] = "Item Master";
}
<!-- PAGE-HEADER -->
<style>

    #Category{
        padding:5px 10px !important;
    }

    #UnitTable input.form-control,
    #BarcodeTable input.form-control,
    #ImageTable input.form-control,
    #UnitTable select.form-control,
    #BarcodeTable select.form-control,
    #ImageTable select.form-control {
        padding: 6px !important;
        box-shadow: none !important;
    }
    /*  border: 0.5px solid #ccc; */
    /*background-color: #e5e5e5 !important;  Optional: make background transparent */

</style>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6 col-12">
                <h2>Item Master</h2>
            </div>
            <div class="col-sm-6 col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="iconly-Home icli svg-color"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Inventory</li>
                    <li class="breadcrumb-item active">Masters</li>
                    <li class="breadcrumb-item active">Item Master</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Zero Configuration  Starts-->
        <div class="col-sm-12">
            <div class="card">
                <div class="list-product-header mt-4">
                    <div>
                        @(await Component.InvokeAsync("ToolBar", new
                        {
                            PageName = "Item Master",
                            AllowNew = ViewBag.UserPermissions.IsCreate,
                            AllowEdit = ViewBag.UserPermissions.IsEdit,
                            AllowDelete = ViewBag.UserPermissions.IsDelete,
                            AllowCopy = ViewBag.UserPermissions.IsCopy,
                            AllowExcelUpload = ViewBag.UserPermissions.IsExcelUpload
                        }))
                        
                    </div>
                   @*  <div class="row" style="" id="importdiv">
                        <div class="col-auto ms-auto">
                            <ul class="quick-file d-flex flex-row align-items-center">
                                <li>
                                    <div class="quick-box position-relative">
                                        <i class="fa-solid fa-download text-success"></i>
                                        <form action='/ItemMaster/ImportFromExcel' method='post' id="ExcelUploadForm" enctype="multipart/form-data" class="position-absolute top-0 start-0 w-100 h-100" style="opacity: 0;" onsubmit='AJAXSubmit2(this);return false;'>
                                            <input type="file" id="excelFile" name="excelFile" accept=".xls,.xlsx" style="width: 100%; height: 100%; cursor: pointer;" />
                                            <input type='submit' style='display:none;' id='ExcelUploadBtn' />
                                        </form>
                                    </div>
                                    <h6 class="mb-2">Upload Excel</h6>
                                </li>
                            </ul>
                        </div>
                    </div> *@

                </div>
                <div class="card-body">
                    <div id="ItemMasterList">
                        <form method="get" action="/ItemMaster/Index">
                            <div class="row mt-3 mb-4">
                                <div class="col-md-3 ">
                                    <div class="row">
                                        <div class="col-md-4 pr-0">
                                            <span class="grpspn">Item Name</span>
                                        </div>
                                        <div class="col-md-8 pl-0" style="position:relative">
                                            <input type="text" name="item" value="@Context.Request.Query["item"]" class="form-control" />

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row">
                                        @(await Component.InvokeAsync("TextBox",
                                        new
                                        {
                                            Type = "Lookup",
                                            ID = "Category",
                                            DisplayText = "Category",
                                            IDColumn = "ID",
                                            LookupCriteria = "ItemCategory",
                                            IDValue = 1,
                                            AssignColumn = "Value",
                                            Value = Context.Request.Query["category"] // pass the category value
                                        }))
                                    </div>
                                    @*<input type="text" name="category" value="@Context.Request.Query["category"]" class="form-control" placeholder="Category" />*@    
                                </div>
                                <div class="col-md-3 ">
                                    <div class="row">
                                        <div class="col-md-4 pr-0">
                                            <span class="grpspn">Brand</span>
                                        </div>
                                        <div class="col-md-8 pl-0" style="position:relative">
                                            <input type="text" name="brand" value="@Context.Request.Query["brand"]" class="form-control" />

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row">
                                        <div class="col-md-4 pr-0">
                                            <span class="grpspn">Model No.</span>
                                        </div>
                                        <div class="col-md-8 pl-0" style="position:relative">
                                            <input type="text" name="modelno" value="@Context.Request.Query["modelno"]" class="form-control" />

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3 mt-3">
                                    <div class="row">
                                        <div class="col-md-4 pr-0">
                                            <span class="grpspn">Barcode</span>
                                        </div>
                                        <div class="col-md-8 pl-0" style="position:relative">
                                            <input type="text" name="barcode" value="@Context.Request.Query["barcode"]" class="form-control" />

                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-1 mt-3">
                                    <button type="submit" class="btn btn-primary w-100">Search</button>
                                </div>
                                <div class="col-md-1 mt-3">
                                    <button type="button" class="btn btn-outline-info w-100" onclick="Reset()">Reset</button>
                                </div>
                            </div>
                        </form>

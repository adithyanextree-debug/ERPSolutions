                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 module-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input ModuleCheck"
                                                                   type="checkbox" value="4"
                                                                   id="Module4" onchange="UpdateModuleCount()">
                                                            <label class="form-check-label" for="Module4">
                                                                Purchase
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 module-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input ModuleCheck"
                                                                   type="checkbox" value="5"
                                                                   id="Module5" onchange="UpdateModuleCount()">
                                                            <label class="form-check-label" for="Module5">
                                                                Payroll
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 module-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input ModuleCheck"
                                                                   type="checkbox" value="6"
                                                                   id="Module6" onchange="UpdateModuleCount()">
                                                            <label class="form-check-label" for="Module6">
                                                                HR
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 module-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input ModuleCheck"
                                                                   type="checkbox" value="7"
                                                                   id="Module7" onchange="UpdateModuleCount()">
                                                            <label class="form-check-label" for="Module7">
                                                                Production
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 module-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input ModuleCheck"
                                                                   type="checkbox" value="8"
                                                                   id="Module8" onchange="UpdateModuleCount()">

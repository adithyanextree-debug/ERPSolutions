                                                                   type="checkbox" value="1"
                                                                   id="Module1" onchange="UpdateModuleCount()">
                                                            <label class="form-check-label" for="Module1">
                                                                Accounts
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 module-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input ModuleCheck"
                                                                   type="checkbox" value="2"
                                                                   id="Module2" onchange="UpdateModuleCount()">
                                                            <label class="form-check-label" for="Module2">
                                                                Inventory
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 module-item">
                                                        <div class="form-check">
                                                            <input class="form-check-input ModuleCheck"
                                                                   type="checkbox" value="3"
                                                                   id="Module3" onchange="UpdateModuleCount()">
                                                            <label class="form-check-label" for="Module3">
                                                                Sales

                                                Edit
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>Company C</td>
                                        <td>0</td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    onclick="EditCompanyModules(3)">
                                                Edit
                                            </button>
                                        </td>
                                    </tr> *@
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ADD / EDIT FORM -->
                    <div id="CompanyModulesForm" style="display:none;">

                        <div class="card">
                            <div class="card-body basic-form">

                                <input type="hidden" id="ID" />
                                <input type="hidden" id="MenuID" value="@ViewBag.MenuID" />

                                <div class="theme-form row g-3">

                                    <!-- Company -->
                                    <div class="col-md-6">
                                        <div class="row align-items-center">
                                            <div class="col-md-3">
                                                <span class="grpspn">Company</span>
                                            </div>
                                            <div class="col-md-9">
                                                <select class="form-control" id="CompanyID">
                                                    
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Module Search -->
                                    <div class="col-md-6">
                                        <div class="row align-items-center">
                                            <div class="col-md-3">
                                                <span class="grpspn">Search Module</span>
                                            </div>
                                            <div class="col-md-9">
                                                <input type="text"
                                                       class="form-control"
                                                       id="ModuleSearch"
                                                       placeholder="Search modules..."
                                                       onkeyup="SearchModules()" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Module Selection -->
                                    <div class="col-md-12 mt-4">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h5>Available Modules</h5>
                                            <span class="text-muted" id="SelectedModuleCount">
                                                0 modules selected
                                            </span>
                                        </div>

                                        <div class="card border">
                                            <div class="card-body">
                                                <div class="row g-3" id="ModuleList">

                                                   @*  <div class="col-md-3 module-item">

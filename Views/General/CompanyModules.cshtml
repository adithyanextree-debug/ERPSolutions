        <div class="col-sm-12">
            <div class="card">

                <div class="list-product-header mt-4">
                    <div>
                        @(await Component.InvokeAsync("ToolBar", new
                        {
                            PageName = "Company Module Mapping",
                            AllowNew = ViewBag.UserPermissions.IsCreate,
                            AllowEdit = ViewBag.UserPermissions.IsEdit,
                            AllowDelete = ViewBag.UserPermissions.IsDelete,
                            AllowCopy = false
                        }))
                    </div>
                </div>
                <div class="card-body">
                    <!-- LISTING SECTION -->
                    <div id="CompanyModulesList">
                        <div class="table-responsive">
                            <table class="display table" id="project-status">
                                <thead>
                                    <tr>
                                        <th>SNo.</th>
                                        <th>Company</th>
                                        <th>No. of Modules</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="CompanyModulesTable">
                                    @Html.Raw(ViewBag.CM)

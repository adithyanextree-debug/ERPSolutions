@model ERPSample.Models.Accounting.Reports.BalanceSheet
@using System.Data
@{
    ViewData["Title"] = "Balance Sheet";
}
<style>
    #ViewBy {
        padding: 10px;
    }
</style>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6 col-12">
                <h2>Balance Sheet</h2>
            </div>
            <div class="col-sm-6 col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="iconly-Home icli svg-color"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Accounting</li>
                    <li class="breadcrumb-item">Statement</li>
                    <li class="breadcrumb-item active">Balance Sheet</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <!-- Zero Configuration  Starts-->
        <div class="col-sm-12">
            <div class="card">
                <div class="list-product-header mt-4">
                    <div>
                        <ul class="quick-file d-flex flex-row">
                            <li onclick="printOnlyTable()">
                                <div class="quick-box">
                                    <i class="fa-solid fa-print text-warning">
                                    </i>
                                </div>
                                <h6 class="mb-2">Print</h6>
                            </li>
                            <li onclick="exportToPDF()">
                                <div class="quick-box">
                                    <i class="fa-solid fa-file text-info"></i>
                                </div>
                                <h6 class="mb-2">PDF</h6>
                            </li>
                            <li onclick="exportToExcel()">
                                <div class="quick-box">
                                    <i class="fa-solid fa-book text-primary"></i>
                                </div>
                                <h6 class="mb-2">Excel</h6>
                            </li>
                            <li onclick="emailTableData()">
                                <div class="quick-box">
                                    <i class="fa-solid fa-envelope text-title-gray"></i>
                                </div>
                                <h6 class="mb-2">Email</h6>
                            </li>
                            <li>
                                <div class="quick-box">
                                    <i class="fa-solid fa-close text-danger"></i>
                                </div>
                                <h6 class="mb-2">Close</h6>
                            </li>

                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    <div id="">
                        <!--Add Details -->
                        <div class="col-md-12">
                            <div class="card">

                                <div class="card-body basic-form">
                                    <form class="theme-form row g-3" method="post" asp-controller="BalanceSheet" asp-action="ShowReport" id="Form">
                                        <div class="col-md-3">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Date", ID = "StartDate", DisplayText = "Date From" }))
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Date", ID = "EndDate", DisplayText = "Date Upto" }))
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "DropDown", ID = "Viewby", DisplayText = "ViewBy" }))
                                                @*   <input type="hidden" id="ViewBy" name="ViewBy" /> *@
                                            </div>
                                        </div>
                                        <div class="col-sm-2">
                                            <div class="">
                                                <button class="btn btn-primary me-2"
                                                        type="submit">
                                                    Submit
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <!-- DEtails Ends  -->
                       
                    </div>

                    <div id="reportContainer">

                        @if (Model != null && Model.ReportTable != null && Model.ReportTable.Tables[0].Rows.Count > 0)
                        {
                            @if (Model.ReportTable.Tables.Count > 1)
                            {
                                <div class="col-sm-12" id="balancesheetTable">
                                    <style type="text/css" media="print">
                                        @@page {
                                            size: landscape;
                                            margin: 20mm 10mm 20mm 10mm;
                                            min-height: 200mm; /* Approx. height for A4 minus margins */
                                        }

                                        @@media print {
                                            .header {
                                                position: fixed;
                                                top: 0;
                                                left: 0;
                                                width: 100%;
                                                height: 80px; /* Adjust as needed */
                                                background-color: #f0f0f0; /* Optional: Add a background color */
                                                z-index: 1; /* Ensure it's above the content */
                                                text-align: center; /* Center the image */
                                                /* Add any other header styles */
                                                display: flex;
                                                justify-content: center;
                                                align-items: center;
                                            }

                                            .footer {
                                                position: fixed;
                                                bottom: 0;
                                                left: 0;
                                                width: 100%;
                                                height: 80px; /* Adjust as needed */
                                                background-color: #f0f0f0; /* Optional: Add a background color */
                                                z-index: 1; /* Ensure it's above the content */
                                                text-align: center; /* Center the image */
                                                /* Add any other footer styles */
                                                display: flex;
                                                justify-content: center;
                                                align-items: center;
                                            }

                                            table, thead, tbody, tr {
                                                page-break-inside: avoid !important;
                                            }

                                                table.table {
                                                    border-collapse: collapse;
                                                    width: 100%;
                                                    table-layout: fixed;
                                                }
                                                    /* Apply inner borders to all cells */
                                                    table.table th,
                                                    table.table td {
                                                        border: 1px solid #e5e5e5;
                                                        font-size: 11px;
                                                        word-wrap: break-word;
                                                        overflow-wrap: break-word;
                                                        white-space: normal; /* Add this to allow multi-line wrapping */
                                                    }
                                                    /* Remove outer borders from first and last columns */
                                                    table.table tr td:first-child,
                                                    table.table tr th:first-child {
                                                        border-left: none;
                                                    }

                                                    table.table tr td:last-child,
                                                    table.table tr th:last-child {
                                                        border-right: none;
                                                    }
                                                    /* Remove top border of the first visible row */
                                                    table.table thead tr:first-child th,
                                                    table.table thead tr:first-child td {
                                                        border-top: none;
                                                    }
                                                    /* Remove bottom border of last row in table */
                                                    table.table tfoot td {
                                                        border: none;
                                                    }
                                                    /* Remove borders from specific cells */
                                                    table.table td.no-border {
                                                        border: none !important;
                                                    }

                                                    table.table th:nth-child(1),
                                                    table.table td:nth-child(1),
                                                    table.table th:nth-child(4),
                                                    table.table td:nth-child(4) {
                                                        width: 14%; /* Account Code - left and right */
                                                    }

                                                    table.table th:nth-child(2),
                                                    table.table td:nth-child(2),
                                                    table.table th:nth-child(5),
                                                    table.table td:nth-child(5) {
                                                        width: 36%; /* Account Name - left and right */
                                                    }

                                                    table.table th:nth-child(3),
                                                    table.table td:nth-child(3),
                                                    table.table th:nth-child(6),
                                                    table.table td:nth-child(6) {
                                                        width: 14%; /* Amount - left and right */
                                                        text-align: right;
                                                    }
                                        }

                                    </style>
                                    <style type="text/css" media="screen">
                                        .header, .footer {
                                            display: none;
                                        }
                                    </style>
                                    <div class="card">
                                        <div class="card-block row">
                                            <div class="col-sm-12 col-lg-12 col-xl-12">
                                                <div class="header">
                                                    <!-- Your header content, including the image -->
                                                    <img id="headerimage" style="height:80px;width:100%;" src="@ViewBag.HeaderImage" />
                                                </div>
                                                <div class="table-responsive">
                                                    <table class="table">
                                                        <thead>
                                                            <tr>
                                                                <td colspan="6" style="height:80px;width:100%;"></td>
                                                            </tr>
                                                            <tr>
                                                                <td class="no-border"></td>
                                                                <td class="no-border"></td>
                                                                <td colspan="2" class="no-border" style="background-color:white; font-weight:bold; text-align:center;">
                                                                    Balance Sheet
                                                                </td>
                                                                <td colspan="2" class="no-border" style="background-color:white; font-weight:bold; text-align:start;">
                                                                    Period: @Model.StartDate.ToString("dd/MM/yyyy") to @Model.EndDate.ToString("dd/MM/yyyy")
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <th>ACCOUNT CODE</th>
                                                                <th>ACCOUNT NAME</th>
                                                                <th>AMOUNT</th>
                                                                <th>ACCOUNT CODE</th>
                                                                <th>ACCOUNT NAME</th>
                                                                <th>AMOUNT</th>
                                                            </tr>

                                                        </thead>
                                                        <tbody>
                                                            @{
                                                                var leftTable = Model.ReportTable.Tables[0];
                                                                var rightTable = Model.ReportTable.Tables.Count > 1 ? Model.ReportTable.Tables[1] : null;

                                                                decimal leftTotal = 0, rightTotal = 0;

                                                                int maxRows = Math.Max(leftTable.Rows.Count, rightTable?.Rows.Count ?? 0);

                                                                for (int i = 0; i < maxRows; i++)
                                                                {
                                                                    var leftRow = i < leftTable.Rows.Count ? leftTable.Rows[i] : null;
                                                                    var rightRow = rightTable != null && i < rightTable.Rows.Count ? rightTable.Rows[i] : null;

                                                                    if (leftRow != null && decimal.TryParse(leftRow["Amount"].ToString(), out var leftAmt))
                                                                    {
                                                                        leftTotal += leftAmt;
                                                                    }

                                                                    if (rightRow != null && decimal.TryParse(rightRow["Amount"].ToString(), out var rightAmt))
                                                                    {
                                                                        rightTotal += rightAmt;
                                                                    }
                                                                    <tr>
                                                                        @* Left Side *@
                                                                        @if (leftRow != null)
                                                                        {
                                                                            var isBold = leftRow["VoucherEntry"].ToString() == "False";
                                                                            <td style="@(isBold ? "font-weight:bold;" : "")">@leftRow["AccountCode"]</td>
                                                                            <td style="white-space: pre-wrap;word-break:break-word;overflow-wrap:break-word; @(isBold ? "font-weight:bold;" : "")">@leftRow["AccountName"]</td>
                                                                            <td style="text-align:right; @(isBold ? "font-weight:bold;" : "")">@String.Format("{0:N2}", leftRow["Amount"])</td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td></td>
                                                                            <td></td>
                                                                            <td></td>
                                                                        }

                                                                        @* Right Side *@
                                                                        @if (rightRow != null)
                                                                        {
                                                                            var isBold = rightRow["VoucherEntry"].ToString() == "False";
                                                                            <td style="@(isBold ? "font-weight:bold;" : "")">@rightRow["AccountCode"]</td>
                                                                            <td style="white-space:pre-wrap;word-break:break-word;overflow-wrap:break-word; @(isBold?"font-weight:bold;" : "")">@rightRow["AccountName"]</td>
                                                                            <td style="text-align:right; @(isBold ? "font-weight:bold;" : "")">@String.Format("{0:N2}", rightRow["Amount"])</td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td></td>
                                                                            <td></td>
                                                                            <td></td>
                                                                        }
                                                                    </tr>
                                                                }
                                                            }

                                                            <tr style="font-weight:bold;">
                                                                <td colspan="2" style="text-align:right;">Total</td>
                                                                <td style="text-align:right;">@String.Format("{0:N2}", leftTotal)</td>
                                                                <td colspan="2" style="text-align:right;">Total</td>
                                                                <td style="text-align:right;">@String.Format("{0:N2}", rightTotal)</td>
                                                            </tr>
                                                        </tbody>

                                                        <tfoot>
                                                            <tr>
                                                                <td colspan="6" style="height:80px;width:100%;"></td>
                                                            </tr>
                                                        </tfoot>
                                                    </table>
                                                </div>

                                                <div class="footer">
                                                    <!-- Your footer content, including the image -->
                                                    <img id="footerimage" style="height:80px;width:100%;" src="@ViewBag.FooterImage" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Table End  -->
                                </div>
                            }
                            else
                            {
                                <div class="col-sm-12" id="balancesheetTable">
                                    <style type="text/css" media="print">
                                        @@page {
                                            size: landscape;
                                            margin: 20mm 10mm 20mm 10mm;
                                            min-height: 200mm; /* Approx. height for A4 minus margins */
                                        }

                                        @@media print {
                                            .header {
                                                position: fixed;
                                                top: 0;
                                                left: 0;
                                                width: 100%;
                                                height: 80px; /* Adjust as needed */
                                                background-color: #f0f0f0; /* Optional: Add a background color */
                                                z-index: 1; /* Ensure it's above the content */
                                                text-align: center; /* Center the image */
                                                /* Add any other header styles */
                                                display: flex;
                                                justify-content: center;
                                                align-items: center;
                                            }

                                            .footer {
                                                position: fixed;
                                                bottom: 0;
                                                left: 0;
                                                width: 100%;
                                                height: 80px; /* Adjust as needed */
                                                background-color: #f0f0f0; /* Optional: Add a background color */
                                                z-index: 1; /* Ensure it's above the content */
                                                text-align: center; /* Center the image */
                                                /* Add any other footer styles */
                                                display: flex;
                                                justify-content: center;
                                                align-items: center;
                                            }

                                            table.table {
                                                border-collapse: collapse;
                                                width: 100%;
                                            }
                                                /* Apply inner borders to all cells */
                                                table.table th,
                                                table.table td {
                                                    border: 1px solid #e5e5e5;
                                                }
                                                /* Remove outer borders from first and last columns */
                                                table.table tr td:first-child,
                                                table.table tr th:first-child {
                                                    border-left: none;
                                                }

                                                table.table tr td:last-child,
                                                table.table tr th:last-child {
                                                    border-right: none;
                                                }
                                                /* Remove top border of the first visible row */
                                                table.table thead tr:first-child th,
                                                table.table thead tr:first-child td {
                                                    border-top: none;
                                                }
                                                /* Remove bottom border of last row in table */
                                                table.table tfoot td {
                                                    border: none;
                                                }
                                                /* Remove borders from specific cells */
                                                table.table td.no-border {
                                                    border: none !important;
                                                }
                                        }

                                    </style>
                                    <style type="text/css" media="screen">
                                        .header, .footer {
                                            display: none;
                                        }
                                    </style>
                                    <div class="card">
                                        <div class="card-block row">
                                            <div class="col-sm-12 col-lg-12 col-xl-12">
                                                <div class="header">
                                                    <!-- Your header content, including the image -->
                                                    <img id="headerimage" style="height:80px;width:100%;" src="@ViewBag.HeaderImage" />
                                                </div>
                                                <div class="table-responsive">
                                                    <table class="table">
                                                        <!-- <caption>List of users</caption> -->

                                                        <thead>
                                                            <tr>
                                                                <td colspan="3" style="height:80px;width:100%;">
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="no-border"></td>
                                                                <td class="no-border" style="background-color:white; font-weight:bold;text-align:center;">
                                                                    Balance Sheet
                                                                </td>
                                                                <td class="no-border" style="background-color:white; font-weight:bold;text-align:center;">
                                                                    Period: @Model.StartDate.ToString("dd/MM/yyyy") to @Model.EndDate.ToString("dd/MM/yyyy")
                                                                </td>
                                                            </tr>
                                                            <tr>

                                                                <th style="text-align:center;width:10cm;">CODE</th>
                                                                <th style="text-align:center;width:10cm;">ACCOUNT NAME</th>
                                                                <th style="text-align:center;width:10cm;">AMOUNT</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                        <tbody class="content">
                                                            @foreach (DataRow dr in Model.ReportTable.Tables[0].Rows)
                                                            {
                                                                bool isBold = dr["VoucherEntry"].ToString() == "False";
                                                                string boldStyle = isBold ? "font-weight: bold;" : "";

                                                                <tr>
                                                                    <td style="@boldStyle">@dr["AccountCode"]</td>
                                                                    <td style="white-space: pre; @boldStyle">@dr["AccountName"]</td>
                                                                    <td style="text-align: right; @boldStyle">@String.Format("{0:N2}", dr["Amount"])</td>
                                                                </tr>
                                                            }
                                                        </tbody>

                                                        </tbody>

                                                        <tfoot>
                                                            <tr>
                                                                <td colspan="3" style="height:80px;width:100%;">
                                                                </td>
                                                            </tr>
                                                        </tfoot>

                                                    </table>
                                                </div>
                                                <div class="footer">
                                                    <!-- Your footer content, including the image -->
                                                    <img id="footerimage" style="height:80px;width:100%;" src="@ViewBag.FooterImage" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Table End  -->
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<!--- list div-->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script src="~/assets/Custom/Accounting/Reports/BalanceSheet.js"></script>
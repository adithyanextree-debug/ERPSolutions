@{
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta name="author" content="pixelstrap">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <title>Nextree ERP</title>
    <!-- Favicon icon-->
    <link rel="icon" href="@Url.Content("~/assets/images/favicon.png") type="image/x-icon" />
    <link rel="shortcut icon" href="../assets/images/favicon.png" ) type="image/x-icon" />
    <!-- Google font-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,200;6..12,300;6..12,400;6..12,500;6..12,600;6..12,700;6..12,800;6..12,900;6..12,1000&amp;display=swap" rel="stylesheet">
    <!-- Flag icon css -->
    <link rel="stylesheet" href="../assets/css/vendors/flag-icon.css">
    <!-- iconly-icon-->
    <link rel="stylesheet" href="../assets/css/iconly-icon.css">
    <link rel="stylesheet" href="../assets/css/bulk-style.css">
    <!-- iconly-icon-->
    <link rel="stylesheet" href="../assets/css/themify.css">
    <!--fontawesome-->
    <link rel="stylesheet" href="../assets/css/fontawesome-min.css">
    <!-- Whether Icon css-->
    <link rel="stylesheet" type="text/css" href="../assets/css/vendors/weather-icons/weather-icons.min.css">
    <!-- App css -->
    <link rel="stylesheet" href="../assets/css/style.css">
    <link id="color" rel="stylesheet" href="../assets/css/color-1.css" media="screen">
</head>
<body>
    <!-- tap on top starts-->
    <div class="tap-top"><i class="iconly-Arrow-Up icli"></i></div>
    <!-- tap on tap ends-->
    <!-- loader-->
    <div class="loader-wrapper">
        <div class="loader"><span></span><span></span><span></span><span></span><span></span></div>
    </div>
    <!-- login page start-->
    <div class="container-fluid p-0">
        <div class="row m-0">
            <div class="col-12 p-0">
                <div class="login-card login-dark">
                    <div>
                        <div><a class="logo" href="#"><img class="img-fluid" src="../assets/images/LoginLogo.png" alt="looginpage"></a></div>
                        <div class="login-main">
                            <form class="theme-form">
                                <h2 class="text-center">Sign in to account</h2>
                                <p class="text-center">Enter your email &amp; password to login</p>
                                <div class="form-group">
@*                                     <label class="col-form-label">Username</label>*@
                                    <select id="Company" class="form-control" onchange="OnCompanyChange()">
                                        @foreach (var item in Model.loginCompaniesModels)
                                        {
                                            <option value="@item.ID"> @item.Name </option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group">
                                    <input class="form-control" id="Username" type="text" required="">
                                </div>
                                <div class="form-group">
                                    <div class="form-input position-relative">
                                        <input class="form-control" type="password" id="password-field" name="login[password]" required="">
                                        <div class="show-hide"><span class="show"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <select class="form-control" id="Branch" required="">
                                    </select>
                                </div>
                                <div class="form-group mb-0 checkbox-checked">
                                    
                                    <div class="text-end mt-3">
                                        <button class="btn btn-primary btn-block w-100" type="button" onclick="Authenticate();">Login </button>
                                    </div>
                                </div>
                                <div class="login-social-title">
                                    <h6>Or Sign in with </h6>
                                </div>
                                <div class="form-group">
                                    <ul class="login-social">
                                        <li><a href="https://www.linkedin.com" target="_blank"><i class="icon-linkedin"></i></a></li>
                                        <li><a href="https://www.facebook.com" target="_blank"><i class="icon-facebook"></i></a></li>
                                        <li><a href="https://www.instagram.com" target="_blank"><i class="icon-instagram"></i></a></li>
                                    </ul>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- jquery-->
        <!-- jQuery (only once) -->
        <script src="@Url.Content("~/assets/js/vendors/jquery/jquery.min.js")"></script>

        <!-- Bootstrap -->
        <script src="@Url.Content("~/assets/js/vendors/bootstrap/dist/js/bootstrap.bundle.min.js")" defer></script>
        <script src="@Url.Content("~/assets/js/vendors/bootstrap/dist/js/popper.min.js")" defer></script>

        <!-- FontAwesome -->
        <script src="@Url.Content("~/assets/js/vendors/font-awesome/fontawesome-min.js")"></script>

        <!-- Password show toggle (if needed) -->
        <script src="@Url.Content("~/assets/js/password.js")"></script>

        <!-- Custom script -->
        <script src="@Url.Content("~/assets/js/script.js")"></script>

        <!--  SweetAlert2 CDN -->
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            // Block back button from showing cached pages
            window.onload = function () {
                // If the user navigates with the back button after logout
                if (performance.navigation.type === performance.navigation.TYPE_BACK_FORWARD) {
                    location.href = '/Login/Index'; // Redirect to login
                }

                // Stronger fallback — disable back completely
                history.pushState(null, null, location.href);
                window.onpopstate = function () {
                    history.go(1); // force forward
                };
            };
        </script>


        <script>
            //var baseUrl = '@ViewBag.BaseUrl';

            function Authenticate() {

                if($("#Username").val() == ""){
                    $("#Username").focus();
                    Swal.fire({
                    icon: 'error',
                    title: 'Oops!',
                    text: "Please Enter User Name!",
                    confirmButtonText: 'Okay',
                    confirmButtonColor: '#d33',
                    });
                    return false;
                }
                if ($("#password-field").val() == "") {

                    $("#password-field").focus();
                    Swal.fire({
                    icon: 'error',
                    title: 'Oops!',
                    text: "Please Enter Your Password !",
                    confirmButtonText: 'Okay',
                    confirmButtonColor: '#d33',
                    });
                    return false;
                }
                var loginShortModel =
                {
                    'ID': 0,
                    'Username': $("#Username").val(),
                    'Password': $("#password-field").val(),
                    'CompanyID': parseInt($('#Company').find(":selected").val()),
                    'BranchID': parseInt($('#Branch').find(":selected").val())
                }
                    $.ajax({
                    url: "/Login/Authenticate",
                        method: "GET",
                        dataType: 'JSON',
                        data: loginShortModel,
                        success: function (data) {
                            if(data.success==0){
                                if ($("#Username").val() != "" && $("#password-field").val() != ""){
                                    Swal.fire({
                                icon: 'error',
                                title: 'Oops!',
                                text: "Invalid User or Password!",
                                confirmButtonText: 'Okay',
                                confirmButtonColor: '#d33',
                                });
                                return false;
                                }
                            }
                            else{

                            window.location =  "/Home/Index";//replace Home page here
                            }
                        },
                    });
            }

            function OnCompanyChange() {
                $('#Branch').empty();
                $.ajax({
                    url:  "/Login/GetBranches",
                    method: "GET",
                    dataType: 'JSON',
                    data: { 'CompanyID': parseInt($('#Company').find(":selected").val()) },
                    success: function (data) {
                        var branchlist = data['branchlist'];
                        for (var i = 0; i < branchlist.length; i++) {
                            $('#Branch').append('<option value="' + branchlist[i]["id"] + '">' + branchlist[i]["name"] + '</option>');
                        }
                    },
                });
            }
            $(document).ready(function () {
                OnCompanyChange();
            });
        </script>

        <script>
            if ('serviceWorker' in navigator) {
                window.addEventListener('load', function () {
                    navigator.serviceWorker.register('/sw.js').then(function (registration) {
                        // Registration was successful
                        console.log('ServiceWorker registration successful with scope: ', registration.scope);
                    }, function (err) {
                        // registration failed :(
                        console.log('ServiceWorker registration failed: ', err);
                    });
                });
            }

            let deferredPrompt;
            var div = document.querySelector('.add-to');
            var button = document.querySelector('.add-to-btn');
            div.style.display = 'none';

            window.addEventListener('beforeinstallprompt', (e) => {
                // Prevent Chrome 67 and earlier from automatically showing the prompt
                e.preventDefault();
                // Stash the event so it can be triggered later.
                deferredPrompt = e;
                div.style.display = 'block';

                button.addEventListener('click', (e) => {
                    // hide our user interface that shows our A2HS button
                    div.style.display = 'none';
                    // Show the prompt
                    deferredPrompt.prompt();
                    // Wait for the user to respond to the prompt
                    deferredPrompt.userChoice
                        .then((choiceResult) => {
                            if (choiceResult.outcome === 'accepted') {
                                console.log('User accepted the A2HS prompt');
                            } else {
                                console.log('User dismissed the A2HS prompt');
                            }
                            deferredPrompt = null;
                        });
                });
            });
        </script>
    </div>
</body>
</html>
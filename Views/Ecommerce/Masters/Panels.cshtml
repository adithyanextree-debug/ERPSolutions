@{
    ViewData["Title"] = "Panel Master";
}
<style>
    #ArabicTitle {
        text-align: right;
    }
</style>
</style>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-sm-6 col-12">
                <h2>Panel Master</h2>
            </div>
            <div class="col-sm-6 col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="iconly-Home icli svg-color"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Ecommerce</li>
                    <li class="breadcrumb-item active">Masters</li>
                    <li class="breadcrumb-item active">Panel Master</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <!-- Zero Configuration  Starts-->
        <div class="col-sm-12">
            <div class="card">
                <div class="list-product-header mt-4">
                    <div>
                        @(await Component.InvokeAsync("ToolBar", new
                        {
                            PageName = "Panel Master",
                            AllowNew = ViewBag.UserPermissions.IsCreate,
                            AllowEdit = ViewBag.UserPermissions.IsEdit,
                            AllowDelete = ViewBag.UserPermissions.IsDelete,
                            AllowCopy = ViewBag.UserPermissions.IsCopy,
                            AllowCancel = ViewBag.UserPermissions.IsCancel
                        }))

                    </div>
                </div>
                <div class="card-body">
                    <div id="PanelMasterList">
                        <div class="table-responsive">
                            <table class="display table" id="project-status">
                                <thead>
                                    <tr>
                                        <th class="col">SNo.</th>
                                        <th>Title</th>
                                        <th>Panel Type</th>
                                        <th>Date</th>
                                        <th>Remarks</th>
                                        <th>Order No.</th>
                                        @* <th>Active</th> *@
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="PanelMasterTable">
                                    @Html.Raw(ViewBag.PanelMaster)
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="PanelMasterForm" style="display:none;">
                        <!--Add Details -->
                        <div class="col-md-12">
                            <div class="card">

                                <div class="card-body basic-form">
                                    <form class="theme-form row g-3">
                                        <input type="text" class="text-center transparent_text" id="ID" style="display:none" />
                                        <input type="text" class="text-center transparent_text" id="MenuID" style="display:none" value="@ViewBag.MenuID" />

                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Normal", ID = "Title", DisplayText = "Title", IsMandatory = true }))
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Normal", ID = "ArabicTitle", DisplayText = "Arabic Title" }))
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Normal", ID = "OrderNo", DisplayText = "Order No.", IsMandatory = true }))

                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Normal", ID = "Remarks", DisplayText = "Remarks" }))
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "DropDown", ID = "PanelType", DisplayText = "Panel Type", IsMandatory = true }))
                                            </div>
                                        </div>
                                        <div class="col-md-4" id="DivPanelTypeValue" style="display:none">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox",
                                                    new
                                                    {
                                                        Type = "Lookup",
                                                        ID = "PanelTypeValue",
                                                        DisplayText = "Panel Value",
                                                        IDColumn = "ID",
                                                        LookupCriteria = "PanelTypeValue",
                                                        IDValue = 1,
                                                        AssignColumn = "Value",
                                                        cssClass = "PanelTypeLookUp", IsMandatory = true
                                                    }))
                                            </div>
                                        </div>
                                        <div class="col-md-4" id="DivShowItemListBtn" style="display:none">
                                            <div class="row">
                                                <div class="col-md-8 pl-0">
                                                    <button type="button" class="btn btn-github btn-sm" id="ShowItemListBtn">Show Products</button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Date", ID = "StartDate", DisplayText = "Start Date" }))

                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "Date", ID = "EndDate", DisplayText = "End Date" }))
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-4">
                                            <div class="row">
                                                <div class="col-md-4 pr-0">
                                                    <span class="grpspn">Active</span>
                                                </div>
                                                <div class="col-md-8 pl-0">
                                                    <li class="list-group-item">
                                                        <div class="form-check form-switch form-check-reverse">
                                                            <input class="form-check-input" id="Active" type="checkbox" role="switch" checked="">
                                                        </div>
                                                    </li>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row">
                                                @(await Component.InvokeAsync("TextBox", new { Type = "DropDown", ID = "SortBy", DisplayText = "Sort By" }))
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <!-- Details Ends  -->
                        <!-- Add Products-->
                        <div class="col-sm-12" id="itemsdetailsection" style="display:none;">
                            <div class="card overflow-hidden">
                                <div class="card-header card-no-border" style="background-color:#C0CAC9">
                                    <h3>Items</h3>
                                </div>
                                <div class="table-responsive">
                                    <table class="table" id="ItemTable">
                                        <thead>
                                            <tr class="border-bottom-dark border-top-0">
                                                <th class="col">S.No</th>
                                                <th class="col">Item ID </th>
                                                <th class="col">Item Name</th>
                                                <th class="col">Selling Price</th>
                                                <th class="col">Active</th>
                                                <th class="col">Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- Add Products End-->

                </div>
                    </div>
            </div>
        </div>
    </div>
</div>

<!--- list div-->
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="~/assets/js/custom-add-product3.js"></script>
<script src="~/assets/custom/Ecommerce/Masters/PanelMaster.js?v=1.0.4"></script>
